# Nova Cinema — environment template.
#
# Only secrets and infrastructure live here. Everything about the cinema itself
# — movies, prices, schedule, contacts, hall size, booking rules, bonuses,
# melodies, gallery — is edited by the administrator inside the Mini App and is
# stored in the database. Never add cinema data to this file.
#
# Copy to .env and fill in. Values already present in the real environment win
# over this file, so Docker and CI can override anything here.

# --- server deployment ------------------------------------------------------
# Only needed for docker-compose.prod.yml; ignored when running locally.

# The name this server answers on, without https:// — Caddy gets a Let's
# Encrypt certificate for it, and Telegram opens a Mini App on nothing less.
NOVA_DOMAIN=

# Where Let's Encrypt writes if a certificate is about to expire.
LETSENCRYPT_EMAIL=

# --- required ---------------------------------------------------------------

# Token issued by @BotFather.
BOT_TOKEN=

# Public HTTPS address of the Mini App. Must be absolute and start with https://
WEBAPP_URL=

# Long random string used to sign JWTs. At least 32 characters.
JWT_SECRET=

# Telegram IDs allowed into the admin panel, comma-separated.
ADMIN_TELEGRAM_IDS=

# --- database ---------------------------------------------------------------

# Leave empty for local development: the app falls back to SQLite (nova-dev.db).
# Production: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# Used by docker-compose to create the PostgreSQL container.
POSTGRES_DB=nova_cinema
POSTGRES_USER=nova
POSTGRES_PASSWORD=

# --- optional ---------------------------------------------------------------

# Origins allowed to call the API, comma-separated. A trailing slash is ignored.
CORS_ORIGINS=http://localhost:5173

# How old Telegram initData may be, in seconds.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Where uploaded posters, gallery photos and melodies are written.
UPLOAD_DIR=uploads

# true creates the schema and seeds demo data on startup, bypassing migrations.
# Keep false in production: alembic owns the schema there.
AUTO_CREATE_SCHEMA=false

# Movie card auto-fill in the admin panel. Both are optional: without them the
# administrator simply types the card in by hand.
TMDB_API_KEY=
OMDB_API_KEY=

# RU/UZ machine translation used by the admin panel. Defaults to a public
# LibreTranslate instance; leave empty to turn the feature off.
TRANSLATION_API_URL=
